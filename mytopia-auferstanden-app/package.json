{
  "name": "mytopia-auferstanden-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "release:bootstrap": "./scripts/run-bundle.sh install",
    "release:ios-beta": "./scripts/run-bundle.sh exec fastlane ios_beta",
    "release:android-beta": "./scripts/run-bundle.sh exec fastlane android_beta",
    "release": "./scripts/run-bundle.sh exec fastlane beta_all",
    "release:lanes": "./scripts/run-bundle.sh exec fastlane lanes",
    "update:js:production": "./scripts/run-eas-update.sh production",
    "update:js:dev": "./scripts/run-eas-update.sh dev",
    "ios:repro": "sh -c 'mkdir -p .logs && LOG=.logs/ios-run-$(date +%Y%m%d-%H%M%S).log && echo Capturing iOS build log to $LOG && EXPO_DEBUG=1 expo run:ios 2>&1 | tee \"$LOG\"'",
    "android:repro": "sh -c 'mkdir -p .logs && LOG=.logs/android-run-$(date +%Y%m%d-%H%M%S).log && echo Capturing Android build log to $LOG && EXPO_DEBUG=1 expo run:android 2>&1 | tee \"$LOG\"'",
    "log:ios": "bunx react-native log-ios",
    "log:android": "bunx react-native log-android",
    "log:metro": "sh -c 'mkdir -p .logs && LOG=.logs/metro-$(date +%Y%m%d-%H%M%S).log && echo Capturing Metro log to $LOG && expo start --clear 2>&1 | tee \"$LOG\"'",
    "feed:probe": "bun ./scripts/probe-feed-api.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/auth": "^23.8.6",
    "@react-native-firebase/crashlytics": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native-firebase/storage": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@simform_solutions/react-native-audio-waveform": "^2.1.6",
    "expo": "~55.0.0",
    "expo-audio": "~55.0.9",
    "expo-build-properties": "~55.0.10",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-file-system": "^55.0.12",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.8",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.8",
    "expo-location": "~55.1.4",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-updates": "~55.0.15",
    "expo-video": "~55.0.11",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
