require "fileutils"
require "json"
require "pathname"
require "shellwords"

APP_IDENTIFIER = "de.theateraltenburggera.mytopia"
IOS_SCHEME = "mytopiaauferstandenapp"
IOS_WORKSPACE = "ios/mytopiaauferstandenapp.xcworkspace"
IOS_ARCHIVE_PATH = "build/ios/mytopia-auferstanden.xcarchive"
IOS_IPA_NAME = "mytopia-auferstanden.ipa"
ANDROID_AAB_PATH = "android/app/build/outputs/bundle/release/app-release.aab"
DEFAULT_IOS_GOOGLE_SERVICES_PATH = "secrets/firebase/GoogleService-Info.plist"
DEFAULT_ANDROID_GOOGLE_SERVICES_PATH = "secrets/firebase/google-services.json"
DEFAULT_ANDROID_CREDENTIALS_JSON_PATH = "secrets/credentials/android/credentials.json"
DEFAULT_ANDROID_KEYSTORE_PATH = "secrets/credentials/android/keystore.jks"
DEFAULT_PLAY_JSON_KEY_PATH = "secrets/fastlane/play/play-console-service-account.json"
DEFAULT_APP_STORE_KEY_DIR = "secrets/fastlane/appstore"

opt_out_usage

def project_root
  File.expand_path("..", __dir__)
end

def app_json_path
  File.join(project_root, "app.json")
end

def absolute_from_project(path)
  Pathname.new(path).absolute? ? path : File.expand_path(path, project_root)
end

def shellescape(value)
  Shellwords.escape(value)
end

def load_app_json
  JSON.parse(File.read(app_json_path))
end

def write_app_json(contents)
  File.write(app_json_path, JSON.pretty_generate(contents) + "\n")
end

def fetch_default_path(relative_path)
  absolute_path = absolute_from_project(relative_path)
  File.exist?(absolute_path) ? absolute_path : nil
end

def require_file_path!(label:, env_key:, default_path: nil)
  path = ENV[env_key]
  path = fetch_default_path(default_path) if path.to_s.strip.empty? && default_path
  path = absolute_from_project(path) unless path.to_s.strip.empty?

  UI.user_error!("#{label} is missing. Set #{env_key} or create #{default_path}.") if path.to_s.strip.empty?
  UI.user_error!("#{label} was not found at #{path}.") unless File.exist?(path)

  path
end

def ensure_bun!
  return if system("which bun >/dev/null 2>&1")

  UI.user_error!("bun is required for release lanes. Install bun and run Fastlane from a shell where bun is available.")
end

def ensure_node_binary!
  return ENV["NODE_BINARY"] if ENV["NODE_BINARY"].to_s.strip != ""

  node_path = `which node`.to_s.strip
  UI.user_error!("node was not found on PATH. Run Fastlane from a terminal session where node is available.") if node_path.empty?

  ENV["NODE_BINARY"] = node_path
  node_path
end

def ensure_ios_team_id!
  team_id = load_app_json.fetch("expo", {}).dig("ios", "appleTeamId").to_s.strip
  UI.user_error!("expo.ios.appleTeamId must be set in app.json for reproducible iOS prebuilds.") if team_id.empty?

  team_id
end

def resolve_google_services!(platform)
  case platform
  when :ios
    require_file_path!(
      label: "GoogleService-Info.plist",
      env_key: "IOS_GOOGLE_SERVICES_FILE",
      default_path: DEFAULT_IOS_GOOGLE_SERVICES_PATH
    )
  when :android
    require_file_path!(
      label: "google-services.json",
      env_key: "ANDROID_GOOGLE_SERVICES_FILE",
      default_path: DEFAULT_ANDROID_GOOGLE_SERVICES_PATH
    )
  else
    UI.user_error!("Unsupported platform #{platform.inspect} for Google services resolution.")
  end
end

def run_prebuild!(platform)
  sh("cd #{shellescape(project_root)} && bunx expo prebuild --platform #{platform} --clean")
end

def increment_ios_build_number!
  app_json = load_app_json
  current_value = app_json.fetch("expo", {}).dig("ios", "buildNumber").to_s
  next_value = current_value.to_i + 1
  app_json.fetch("expo").fetch("ios")["buildNumber"] = next_value.to_s
  write_app_json(app_json)
  UI.message("Updated app.json ios.buildNumber to #{next_value}")
  next_value.to_s
end

def increment_android_version_code!
  app_json = load_app_json
  current_value = app_json.fetch("expo", {}).dig("android", "versionCode").to_i
  next_value = current_value + 1
  app_json.fetch("expo").fetch("android")["versionCode"] = next_value
  write_app_json(app_json)
  UI.message("Updated app.json android.versionCode to #{next_value}")
  next_value
end

def ios_api_key!
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  UI.user_error!("APP_STORE_CONNECT_KEY_ID is required for ios_beta.") if key_id.empty?
  UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is required for ios_beta.") if issuer_id.empty?

  key_path =
    if ENV["APP_STORE_CONNECT_KEY_PATH"].to_s.strip != ""
      absolute_from_project(ENV["APP_STORE_CONNECT_KEY_PATH"])
    else
      exact_match = absolute_from_project(File.join(DEFAULT_APP_STORE_KEY_DIR, "AuthKey_#{key_id}.p8"))
      if File.exist?(exact_match)
        exact_match
      else
        matches = Dir[absolute_from_project(File.join(DEFAULT_APP_STORE_KEY_DIR, "AuthKey_*.p8"))]
        UI.user_error!(
          "App Store Connect API key file is missing. Set APP_STORE_CONNECT_KEY_PATH or add a single AuthKey_*.p8 file under #{DEFAULT_APP_STORE_KEY_DIR}."
        ) unless matches.length == 1

        matches.first
      end
    end

  UI.user_error!("App Store Connect API key file was not found at #{key_path}.") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

def android_signing!
  credentials_path =
    if ENV["ANDROID_CREDENTIALS_JSON_PATH"].to_s.strip != ""
      absolute_from_project(ENV["ANDROID_CREDENTIALS_JSON_PATH"])
    else
      fetch_default_path(DEFAULT_ANDROID_CREDENTIALS_JSON_PATH)
    end

  credentials = {}
  if credentials_path && File.exist?(credentials_path)
    data = JSON.parse(File.read(credentials_path))
    credentials = data.fetch("android", {}).fetch("keystore", {})
  end

  store_file = require_file_path!(
    label: "Android upload keystore",
    env_key: "ANDROID_KEYSTORE_PATH",
    default_path: DEFAULT_ANDROID_KEYSTORE_PATH
  )
  store_password = ENV["ANDROID_KEYSTORE_PASSWORD"].to_s.strip
  store_password = credentials["keystorePassword"].to_s.strip if store_password.empty?
  key_alias = ENV["ANDROID_KEY_ALIAS"].to_s.strip
  key_alias = credentials["keyAlias"].to_s.strip if key_alias.empty?
  key_password = ENV["ANDROID_KEY_PASSWORD"].to_s.strip
  key_password = credentials["keyPassword"].to_s.strip if key_password.empty?

  UI.user_error!(
    "Android signing credentials are incomplete. Provide ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD or keep #{DEFAULT_ANDROID_CREDENTIALS_JSON_PATH} available."
  ) if [store_password, key_alias, key_password].any?(&:empty?)

  {
    store_file: store_file,
    store_password: store_password,
    key_alias: key_alias,
    key_password: key_password
  }
end

def play_json_key_path!
  require_file_path!(
    label: "Google Play service account JSON",
    env_key: "PLAY_JSON_KEY_PATH",
    default_path: DEFAULT_PLAY_JSON_KEY_PATH
  )
end

before_all do
  ENV["LANG"] ||= "en_US.UTF-8"
  ENV["LC_ALL"] ||= "en_US.UTF-8"
end

desc "Build and upload the iOS beta to TestFlight"
lane :ios_beta do
  ensure_bun!
  ensure_node_binary!

  resolve_google_services!(:ios)
  team_id = ensure_ios_team_id!
  api_key = ios_api_key!
  build_number = increment_ios_build_number!

  run_prebuild!(:ios)

  output_directory = absolute_from_project("build/ios")
  archive_path = absolute_from_project(IOS_ARCHIVE_PATH)
  FileUtils.mkdir_p(output_directory)

  gym(
    workspace: absolute_from_project(IOS_WORKSPACE),
    scheme: IOS_SCHEME,
    configuration: "Release",
    clean: true,
    archive_path: archive_path,
    output_directory: output_directory,
    output_name: IOS_IPA_NAME,
    export_method: "app-store",
    export_team_id: team_id,
    silent: false
  )

  upload_to_testflight(
    api_key: api_key,
    ipa: File.join(output_directory, IOS_IPA_NAME),
    skip_waiting_for_build_processing: true
  )

  UI.success("Uploaded iOS build #{build_number} to TestFlight.")
end

desc "Build and upload the Android beta to Play Internal Testing"
lane :android_beta do
  ensure_bun!
  ensure_node_binary!

  resolve_google_services!(:android)
  signing = android_signing!
  play_json = play_json_key_path!
  version_code = increment_android_version_code!

  run_prebuild!(:android)

  gradle(
    task: "bundle",
    build_type: "Release",
    project_dir: absolute_from_project("android"),
    print_command: false,
    properties: {
      "node.binary" => ENV["NODE_BINARY"],
      "android.injected.signing.store.file" => signing[:store_file],
      "android.injected.signing.store.password" => signing[:store_password],
      "android.injected.signing.key.alias" => signing[:key_alias],
      "android.injected.signing.key.password" => signing[:key_password]
    }
  )

  supply(
    aab: absolute_from_project(ANDROID_AAB_PATH),
    package_name: APP_IDENTIFIER,
    track: "internal",
    json_key: play_json,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true
  )

  UI.success("Uploaded Android versionCode #{version_code} to Play Internal Testing.")
end

desc "Build and upload iOS TestFlight and Android Internal Testing betas"
lane :beta_all do
  ios_beta
  android_beta
end
