require "fileutils"
require "json"
require "pathname"
require "shellwords"

DEFAULT_APP_IDENTIFIER = "com.example.mytopia"
DEFAULT_ANDROID_PACKAGE = "com.example.mytopia"
DEFAULT_IOS_SCHEME = "mytopiaapp"
IOS_ARCHIVE_PATH = "build/ios/mytopia-auferstanden.xcarchive"
IOS_IPA_NAME = "mytopia-auferstanden.ipa"
ANDROID_AAB_PATH = "android/app/build/outputs/bundle/release/app-release.aab"
DEFAULT_IOS_GOOGLE_SERVICES_PATH = "secrets/firebase/GoogleService-Info.plist"
DEFAULT_ANDROID_GOOGLE_SERVICES_PATH = "secrets/firebase/google-services.json"
DEFAULT_ANDROID_CREDENTIALS_JSON_PATH = "secrets/credentials/android/credentials.json"
DEFAULT_ANDROID_KEYSTORE_PATH = "secrets/credentials/android/keystore.jks"
DEFAULT_PLAY_JSON_KEY_PATH = "secrets/fastlane/play/play-console-service-account.json"
DEFAULT_APP_STORE_KEY_DIR = "secrets/fastlane/appstore"

opt_out_usage

def project_root
  File.expand_path("..", __dir__)
end

def app_json_path
  File.join(project_root, "app.json")
end

def absolute_from_project(path)
  Pathname.new(path).absolute? ? path : File.expand_path(path, project_root)
end

def shellescape(value)
  Shellwords.escape(value)
end

def load_app_json
  JSON.parse(File.read(app_json_path))
end

def write_app_json(contents)
  File.write(app_json_path, JSON.pretty_generate(contents) + "\n")
end

def non_empty(value)
  normalized = value.to_s.strip
  normalized.empty? ? nil : normalized
end

def app_identifier
  env_value = (ENV["FASTLANE_APP_IDENTIFIER"] || ENV["IOS_BUNDLE_IDENTIFIER"]).to_s.strip
  return env_value unless env_value.empty?

  non_empty(load_app_json.fetch("expo", {}).dig("ios", "bundleIdentifier")) || DEFAULT_APP_IDENTIFIER
end

def android_package
  env_value = (ENV["FASTLANE_ANDROID_PACKAGE"] || ENV["ANDROID_PACKAGE"]).to_s.strip
  return env_value unless env_value.empty?

  non_empty(load_app_json.fetch("expo", {}).dig("android", "package")) || DEFAULT_ANDROID_PACKAGE
end

def ios_scheme
  env_value = (ENV["IOS_SCHEME"] || ENV["EXPO_IOS_SCHEME"] || ENV["EXPO_APP_SCHEME"]).to_s.strip
  env_value.empty? ? DEFAULT_IOS_SCHEME : env_value
end

def ios_workspace
  env_value = ENV["IOS_WORKSPACE"].to_s.strip
  env_value.empty? ? "ios/#{ios_scheme}.xcworkspace" : env_value
end

def fetch_default_path(relative_path)
  absolute_path = absolute_from_project(relative_path)
  File.exist?(absolute_path) ? absolute_path : nil
end

def require_file_path!(label:, env_key:, default_path: nil)
  path = ENV[env_key]
  path = fetch_default_path(default_path) if path.to_s.strip.empty? && default_path
  path = absolute_from_project(path) unless path.to_s.strip.empty?

  UI.user_error!("#{label} is missing. Set #{env_key} or create #{default_path}.") if path.to_s.strip.empty?
  UI.user_error!("#{label} was not found at #{path}.") unless File.exist?(path)

  path
end

def load_env_file!(env_file, override: false)
  return unless File.exist?(env_file)

  begin
    require "dotenv"
    override ? Dotenv.overload(env_file) : Dotenv.load(env_file)
  rescue LoadError
    File.readlines(env_file).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      
      key, value = line.split("=", 2)
      next unless key && value
      
      value = value.strip.gsub(/\A['"]|['"]\Z/, '')
      ENV[key.strip] = value if override || ENV[key.strip].to_s.empty?
    end
  end
end

def load_release_env!
  load_env_file!(absolute_from_project(".env"), override: false)
  load_env_file!(absolute_from_project(".env.local"), override: true)
end

def ensure_bun!
  return if system("which bun >/dev/null 2>&1")

  UI.user_error!("bun is required for release lanes. Install bun and run Fastlane from a shell where bun is available.")
end

def ensure_node_binary!
  return ENV["NODE_BINARY"] if ENV["NODE_BINARY"].to_s.strip != ""

  node_path = `which node`.to_s.strip
  UI.user_error!("node was not found on PATH. Run Fastlane from a terminal session where node is available.") if node_path.empty?

  ENV["NODE_BINARY"] = node_path
  node_path
end

def ensure_ios_team_id!
  team_id = (ENV["IOS_APPLE_TEAM_ID"] || load_app_json.fetch("expo", {}).dig("ios", "appleTeamId")).to_s.strip
  UI.user_error!("IOS_APPLE_TEAM_ID must be set in .env.local for reproducible iOS prebuilds.") if team_id.empty?

  team_id
end

def resolve_google_services!(platform)
  case platform
  when :ios
    require_file_path!(
      label: "GoogleService-Info.plist",
      env_key: "IOS_GOOGLE_SERVICES_FILE",
      default_path: DEFAULT_IOS_GOOGLE_SERVICES_PATH
    )
  when :android
    require_file_path!(
      label: "google-services.json",
      env_key: "ANDROID_GOOGLE_SERVICES_FILE",
      default_path: DEFAULT_ANDROID_GOOGLE_SERVICES_PATH
    )
  else
    UI.user_error!("Unsupported platform #{platform.inspect} for Google services resolution.")
  end
end

def run_prebuild!(platform)
  # Prebuild without installing pods
  sh("cd #{shellescape(project_root)} && bunx expo prebuild --platform #{platform} --no-install")
  
  if platform == :ios
    # Clear bundler environment before running pod install to avoid Gemfile conflicts,
    # as Expo expects `pod install` to run in a fresh ruby context
    sh("cd #{shellescape(project_root)}/ios && env -u BUNDLE_BIN_PATH -u BUNDLE_GEMFILE -u RUBYOPT pod install --repo-update")
  end
end

def verify_release_config!(platform)
  sh("cd #{shellescape(project_root)} && bun ./scripts/verify-release-config.mjs production --native --platform #{platform}")
end

def increment_ios_build_number!
  app_json = load_app_json
  current_value = app_json.fetch("expo", {}).dig("ios", "buildNumber").to_s
  next_value = current_value.to_i + 1
  app_json.fetch("expo").fetch("ios")["buildNumber"] = next_value.to_s
  write_app_json(app_json)
  UI.message("Updated app.json ios.buildNumber to #{next_value}")
  next_value.to_s
end

def increment_android_version_code!
  app_json = load_app_json
  current_value = app_json.fetch("expo", {}).dig("android", "versionCode").to_i
  next_value = current_value + 1
  app_json.fetch("expo").fetch("android")["versionCode"] = next_value
  write_app_json(app_json)
  UI.message("Updated app.json android.versionCode to #{next_value}")
  next_value
end

def normalize_release_version!(version)
  normalized = version.to_s.strip
  UI.user_error!("expo.version must be set in app.json for release lanes.") if normalized.empty?

  segments = normalized.split(".")
  unless segments.length.between?(2, 3) && segments.all? { |segment| segment.match?(/\A\d+\z/) }
    UI.user_error!(
      "expo.version '#{normalized}' must use 'major.minor' or 'major.minor.patch'. " \
      "Set RELEASE_APP_VERSION to an explicit value when you need to override the automatic bump."
    )
  end

  normalized
end

def set_release_version!(version)
  normalized = normalize_release_version!(version)
  app_json = load_app_json
  app_json.fetch("expo")["version"] = normalized
  write_app_json(app_json)
  UI.message("Updated app.json expo.version to #{normalized}")
  normalized
end

def reset_ota_version!
  app_json = load_app_json
  expo = app_json.fetch("expo")
  extra = expo["extra"].is_a?(Hash) ? expo["extra"] : {}
  expo["extra"] = extra

  if extra.key?("otaVersion") && extra["otaVersion"].to_s.empty?
    UI.message("Keeping app.json expo.extra.otaVersion empty")
    return
  end

  extra["otaVersion"] = ""
  write_app_json(app_json)
  UI.message("Reset app.json expo.extra.otaVersion to empty for native release")
end

def next_release_version(current_version)
  segments = normalize_release_version!(current_version).split(".")
  segments << "0" if segments.length == 2
  segments[-1] = (segments[-1].to_i + 1).to_s
  segments.join(".")
end

def prepare_release_version!
  prepared_version = ENV["FASTLANE_RELEASE_VERSION_VALUE"].to_s.strip
  unless prepared_version.empty?
    reset_ota_version!
    return prepared_version
  end

  current_version = normalize_release_version!(load_app_json.fetch("expo", {}).fetch("version", ""))
  requested_version = ENV["RELEASE_APP_VERSION"].to_s.strip
  release_version =
    if requested_version.empty?
      next_release_version(current_version)
    else
      normalize_release_version!(requested_version)
    end

  if release_version == current_version
    UI.message("Keeping app.json expo.version at #{release_version}")
  else
    set_release_version!(release_version)
  end

  reset_ota_version!
  ENV["FASTLANE_RELEASE_VERSION_VALUE"] = release_version
  release_version
end

def require_apple_id!
  apple_id = (ENV["APPLE_ID"] || ENV["FASTLANE_USER"]).to_s.strip
  UI.user_error!("APPLE_ID or FASTLANE_USER is required for ios_beta when not using App Store Connect API keys.") if apple_id.empty?
  apple_id
end

def app_store_connect_api_key_if_configured
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  key_path = ENV["APP_STORE_CONNECT_KEY_PATH"].to_s.strip

  return nil if [key_id, issuer_id, key_path].all?(&:empty?)

  if [key_id, issuer_id, key_path].any?(&:empty?)
    UI.user_error!("APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, and APP_STORE_CONNECT_KEY_PATH must all be set together.")
  end

  resolved_key_path = absolute_from_project(key_path)
  UI.user_error!("App Store Connect API key was not found at #{resolved_key_path}.") unless File.exist?(resolved_key_path)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: resolved_key_path,
    duration: 1200,
    in_house: false
  )
end

def xcode_authentication_xcargs
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  key_path = ENV["APP_STORE_CONNECT_KEY_PATH"].to_s.strip

  return nil if [key_id, issuer_id, key_path].any?(&:empty?)

  resolved_key_path = absolute_from_project(key_path)
  [
    "-authenticationKeyPath #{shellescape(resolved_key_path)}",
    "-authenticationKeyID #{shellescape(key_id)}",
    "-authenticationKeyIssuerID #{shellescape(issuer_id)}"
  ].join(" ")
end

def android_signing!
  credentials_path =
    if ENV["ANDROID_CREDENTIALS_JSON_PATH"].to_s.strip != ""
      absolute_from_project(ENV["ANDROID_CREDENTIALS_JSON_PATH"])
    else
      fetch_default_path(DEFAULT_ANDROID_CREDENTIALS_JSON_PATH)
    end

  credentials = {}
  if credentials_path && File.exist?(credentials_path)
    data = JSON.parse(File.read(credentials_path))
    credentials = data.fetch("android", {}).fetch("keystore", {})
  end

  store_file = require_file_path!(
    label: "Android upload keystore",
    env_key: "ANDROID_KEYSTORE_PATH",
    default_path: DEFAULT_ANDROID_KEYSTORE_PATH
  )
  store_password = ENV["ANDROID_KEYSTORE_PASSWORD"].to_s.strip
  store_password = credentials["keystorePassword"].to_s.strip if store_password.empty?
  key_alias = ENV["ANDROID_KEY_ALIAS"].to_s.strip
  key_alias = credentials["keyAlias"].to_s.strip if key_alias.empty?
  key_password = ENV["ANDROID_KEY_PASSWORD"].to_s.strip
  key_password = credentials["keyPassword"].to_s.strip if key_password.empty?

  UI.user_error!(
    "Android signing credentials are incomplete. Provide ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD or keep #{DEFAULT_ANDROID_CREDENTIALS_JSON_PATH} available."
  ) if [store_password, key_alias, key_password].any?(&:empty?)

  {
    store_file: store_file,
    store_password: store_password,
    key_alias: key_alias,
    key_password: key_password
  }
end

def play_json_key_path
  path = ENV["PLAY_JSON_KEY_PATH"]
  path = fetch_default_path(DEFAULT_PLAY_JSON_KEY_PATH) if path.to_s.strip.empty? && DEFAULT_PLAY_JSON_KEY_PATH
  path = absolute_from_project(path) unless path.to_s.strip.empty?
  
  (path && File.exist?(path)) ? path : nil
end

before_all do
  ENV["LANG"] ||= "en_US.UTF-8"
  ENV["LC_ALL"] ||= "en_US.UTF-8"
  load_release_env!
end

desc "Build and upload the iOS beta to TestFlight"
lane :ios_beta do
  ENV["EXPO_PUBLIC_APP_ENV"] = "production"
  ensure_bun!
  ensure_node_binary!

  release_version = prepare_release_version!
  resolve_google_services!(:ios)
  team_id = ensure_ios_team_id!
  api_key = app_store_connect_api_key_if_configured
  apple_id = api_key ? nil : require_apple_id!
  build_number = increment_ios_build_number!
  verify_release_config!("ios")

  run_prebuild!(:ios)

  output_directory = absolute_from_project("build/ios")
  archive_path = absolute_from_project(IOS_ARCHIVE_PATH)
  FileUtils.mkdir_p(output_directory)

  # Check if the user specified a manual provisioning profile.
  # Set IOS_SIGNING_STYLE=automatic to let Xcode refresh profiles after
  # capability changes without editing ignored local env files.
  prov_profile = ENV["IOS_PROVISIONING_PROFILE_NAME"].to_s.strip
  signing_style = ENV["IOS_SIGNING_STYLE"].to_s.strip.downcase

  export_options = {
    method: "app-store",
    teamID: team_id
  }

  if signing_style == "automatic"
    export_options[:signingStyle] = "automatic"
  elsif !prov_profile.empty?
    export_options[:provisioningProfiles] = {
      app_identifier => prov_profile
    }
    export_options[:signingStyle] = "manual"
  end

  gym_options = {
    workspace: absolute_from_project(ios_workspace),
    scheme: ios_scheme,
    configuration: "Release",
    clean: true,
    archive_path: archive_path,
    output_directory: output_directory,
    output_name: IOS_IPA_NAME,
    export_options: export_options,
    silent: false
  }

  if signing_style == "automatic"
    xcode_auth_args = xcode_authentication_xcargs
    signing_args = ["-allowProvisioningUpdates"]
    signing_args << xcode_auth_args unless xcode_auth_args.to_s.empty?
    gym_options[:xcargs] = signing_args.join(" ")
    gym_options[:export_xcargs] = signing_args.join(" ")
  end

  gym(**gym_options)

  testflight_options = {
    ipa: File.join(output_directory, IOS_IPA_NAME),
    skip_waiting_for_build_processing: true
  }
  if api_key
    testflight_options[:api_key] = api_key
  else
    testflight_options[:username] = apple_id
  end

  upload_to_testflight(**testflight_options)

  UI.success("Uploaded iOS build #{build_number} (app version #{release_version}) to TestFlight.")
end

desc "Build and upload the Android beta to Play Internal Testing"
lane :android_beta do
  ENV["EXPO_PUBLIC_APP_ENV"] = "production"
  ensure_bun!
  ensure_node_binary!

  release_version = prepare_release_version!
  resolve_google_services!(:android)
  signing = android_signing!
  play_json = play_json_key_path
  version_code = increment_android_version_code!
  verify_release_config!("android")

  run_prebuild!(:android)

  gradle(
    task: "bundle",
    build_type: "Release",
    project_dir: absolute_from_project("android"),
    print_command: false,
    properties: {
      "node.binary" => ENV["NODE_BINARY"],
      "android.injected.signing.store.file" => signing[:store_file],
      "android.injected.signing.store.password" => signing[:store_password],
      "android.injected.signing.key.alias" => signing[:key_alias],
      "android.injected.signing.key.password" => signing[:key_password]
    }
  )

  # Move artifact to top-level build folder
  output_directory = absolute_from_project("build/android")
  aab_filename = "app-release.aab"
  destination_path = File.join(output_directory, aab_filename)
  
  FileUtils.mkdir_p(output_directory)
  FileUtils.cp(absolute_from_project(ANDROID_AAB_PATH), destination_path)

  if play_json
    supply(
      aab: destination_path,
      package_name: android_package,
      track: "internal",
      json_key: play_json,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
    UI.success("Uploaded Android versionCode #{version_code} (app version #{release_version}) to Play Internal Testing.")
  else
    UI.important("Google Play service account JSON is missing (PLAY_JSON_KEY_PATH).")
    UI.success("Successfully built Android versionCode #{version_code} (app version #{release_version}). You can now manually upload the AAB to the Google Play Console.")
  end

  UI.message("AAB Location: #{destination_path}")
end

desc "Build and upload iOS TestFlight and Android Internal Testing betas"
lane :beta_all do
  prepare_release_version!
  ios_beta
  android_beta
end
