{
  "expo": {
    "name": "mytopia-auferstanden-app",
    "slug": "mytopia-auferstanden-app",
    "version": "1.0.17",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bb713621-f181-417e-84f4-c11b855769c9",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "backgroundColor": "#ff7a1a",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mytopiaauferstandenapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "buildNumber": "40",
      "appleTeamId": "2YM33HYFWJ",
      "bundleIdentifier": "de.theateraltenburggera.mytopia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Wir benötigen deinen Standort, um GPS-Missionen durchzuführen und deine Entfernung zum Ziel anzuzeigen.",
        "NSCameraUsageDescription": "Wir benötigen Zugriff auf deine Kamera, damit du Fotos für Missionen aufnehmen kannst.",
        "NSPhotoLibraryUsageDescription": "Wir benötigen Zugriff auf deine Mediathek, damit du Fotos für Missionen auswählen kannst."
      }
    },
    "android": {
      "versionCode": 25,
      "adaptiveIcon": {
        "backgroundColor": "#ff7a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.theateraltenburggera.mytopia",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraParams": {
              "org.gradle.jvmargs": "-Xmx3072m -XX:MaxMetaspaceSize=1024m"
            }
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ff7a1a"
        }
      ],
      "expo-updates",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wir benötigen deinen Standort, um GPS-Missionen durchzuführen und deine Entfernung zum Ziel anzuzeigen."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wir benötigen Zugriff auf deine Kamera, damit du Fotos für Missionen aufnehmen kannst.",
          "photosPermission": "Wir benötigen Zugriff auf deine Mediathek, damit du Fotos für Missionen auswählen kannst."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ff7a1a",
          "ios": {
            "image": "./assets/images/splash-screen.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover"
          },
          "android": {
            "image": "./assets/images/android-splash-icon.png",
            "imageWidth": 180,
            "resizeMode": "contain"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb713621-f181-417e-84f4-c11b855769c9"
      },
      "otaVersion": "20-04"
    }
  }
}
