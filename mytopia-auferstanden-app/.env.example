EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FEED_API_BASE_URL=https://europe-west1-<project-id>.cloudfunctions.net/narrativeApi/
EXPO_PUBLIC_MISSION_API_BASE_URL=https://europe-west1-<project-id>.cloudfunctions.net/missionApi/
EXPO_PUBLIC_NARRATIVE_TOPIC=narrative-topic
EXPO_PUBLIC_NARRATIVE_TOPIC_DEV=narrative-topic-dev
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=production
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# App identity and EAS Updates.
# Required for production updates/releases. Quote values that contain spaces.
EXPO_APP_NAME="Mytopia App"
EXPO_APP_SCHEME=mytopiaapp
EXPO_EAS_PROJECT_ID=
EXPO_UPDATES_URL=
EXPO_UPDATES_CHANNEL=production
IOS_BUNDLE_IDENTIFIER=com.example.mytopia
IOS_APPLE_TEAM_ID=
ANDROID_PACKAGE=com.example.mytopia

# Local Firebase native config file paths (do not commit files)
ANDROID_GOOGLE_SERVICES_FILE=./secrets/firebase/google-services.json
IOS_GOOGLE_SERVICES_FILE=./secrets/firebase/GoogleService-Info.plist

# Native release credentials (optional unless you build store releases locally)
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=./secrets/fastlane/appstore/AuthKey_<KEY_ID>.p8
IOS_SIGNING_STYLE=
IOS_PROVISIONING_PROFILE_NAME=
PLAY_JSON_KEY_PATH=./secrets/fastlane/play/play-console-service-account.json
ANDROID_KEYSTORE_PATH=./secrets/credentials/android/keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
