rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token[role] == true;
    }

    function isModerator() {
      return hasRole('admin') || hasRole('moderator');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSubmissionOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function hasDevClaim() {
      return isSignedIn() && request.auth.token.dev == true;
    }

    function liveSessionDoc(sessionId) {
      return get(/databases/$(database)/documents/v2/app/liveSessions/$(sessionId));
    }

    function canReadLiveSession(sessionId) {
      return isModerator()
        || (
          isSignedIn()
          && liveSessionDoc(sessionId).data.mode == 'production'
        )
        || (
          hasDevClaim()
          && liveSessionDoc(sessionId).data.mode == 'dev'
        );
    }

    function isLiveSessionParticipant(sessionId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/v2/app/liveSessions/$(sessionId)/participants/$(request.auth.uid));
    }

    function canReadNarrativeReactionDoc(docId) {
      return isSignedIn()
        && (
          docId.matches('^production__[^/]+$')
          || (docId.matches('^dev__[^/]+$') && hasDevClaim())
        );
    }

    function isNarrativeUserReactionOwnerDoc(docId) {
      return isSignedIn()
        && (
          docId.matches('^production__' + request.auth.uid + '__[^/]+$')
          || (docId.matches('^dev__' + request.auth.uid + '__[^/]+$') && hasDevClaim())
        );
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys);
    }

    function hasRequiredKeys(data, keys) {
      return data.keys().hasAll(keys);
    }

    function hasValidLegacySummary(data) {
      return !data.keys().hasAny(['legacySummary'])
        || (
          data.legacySummary is map
          && data.legacySummary.keys().hasOnly([
            'totalPoints',
            'rankSnapshot',
            'importedAt',
            'citizenship',
            'properties'
          ])
          && data.legacySummary.keys().hasAll(['totalPoints', 'rankSnapshot', 'importedAt'])
          && data.legacySummary.totalPoints is number
          && data.legacySummary.rankSnapshot is number
          && data.legacySummary.rankSnapshot > 0
          && data.legacySummary.importedAt is string
          && (
            !data.legacySummary.keys().hasAny(['citizenship'])
            || data.legacySummary.citizenship is map
          )
          && (
            !data.legacySummary.keys().hasAny(['properties'])
            || data.legacySummary.properties is list
          )
        );
    }

    function isAllowedUserProfileWrite(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && hasValidLegacySummary(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['photoURL'])
          || request.resource.data.photoURL is string
        )
        && (
          !request.resource.data.keys().hasAny(['pointsCurrent'])
          || request.resource.data.pointsCurrent is number
        )
        && (
          !request.resource.data.keys().hasAny(['streakCount'])
          || request.resource.data.streakCount is number
        )
        && (
          !request.resource.data.keys().hasAny(['streakLastUpdatedAt'])
          || request.resource.data.streakLastUpdatedAt is string
        )
        && (
          !request.resource.data.keys().hasAny(['streakMultiplierCurrent'])
          || request.resource.data.streakMultiplierCurrent is number
        )
        && (
          !request.resource.data.keys().hasAny(['awardedGroupBonusIds'])
          || request.resource.data.awardedGroupBonusIds is list
        )
        && hasOnlyKeys(request.resource.data, [
          'uid',
          'displayName',
          'email',
          'photoURL',
          'legacySummary',
          'pointsCurrent',
          'streakCount',
          'streakLastUpdatedAt',
          'streakMultiplierCurrent',
          'awardedGroupBonusIds',
          'createdAt',
          'updatedAt'
        ]);
    }

    function isAllowedScoreEvent(eventId) {
      return hasOnlyKeys(request.resource.data, [
          'uid',
          'delta',
          'reason',
          'sourceType',
          'sourceId',
          'idempotencyKey',
          'createdAt',
          'createdBy',
          'metadata'
        ])
        && hasRequiredKeys(request.resource.data, [
          'uid',
          'delta',
          'reason',
          'sourceType',
          'sourceId',
          'idempotencyKey',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.uid is string
        && request.resource.data.delta is int
        && request.resource.data.delta != 0
        && request.resource.data.reason in [
          'text_approved',
          'photo_approved',
          'moderation_penalty',
          'quiz_completed',
          'gps_completed',
          'legacy_import',
          'manual_adjustment'
        ]
        && request.resource.data.sourceType in ['submission', 'quiz', 'gps', 'text', 'photo', 'import', 'admin']
        && request.resource.data.sourceId is string
        && request.resource.data.idempotencyKey is string
        && request.resource.data.idempotencyKey.size() > 0
        && request.resource.data.idempotencyKey == eventId
        && request.resource.data.createdBy is string;
    }

    function isAllowedChannelThreadWrite() {
      return hasOnlyKeys(request.resource.data, [
          'actorId',
          'avatarUrl',
          'channelId',
          'channelType',
          'lastMessageAtMs',
          'lastPreview',
          'lastReadAtMs',
          'messageCount',
          'mode',
          'openedAtMs',
          'ownerUid',
          'role',
          'title',
          'unreadCount'
        ])
        && hasRequiredKeys(request.resource.data, [
          'channelId',
          'channelType',
          'lastMessageAtMs',
          'lastPreview',
          'lastReadAtMs',
          'messageCount',
          'mode',
          'openedAtMs',
          'ownerUid',
          'title',
          'unreadCount'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.channelId is string
        && request.resource.data.channelType in ['hub', 'actor']
        && request.resource.data.lastMessageAtMs is number
        && request.resource.data.lastPreview is string
        && request.resource.data.lastReadAtMs is number
        && request.resource.data.messageCount is number
        && request.resource.data.mode in ['production', 'dev']
        && request.resource.data.openedAtMs is number
        && request.resource.data.title is string
        && request.resource.data.unreadCount is number
        && (
          !request.resource.data.keys().hasAny(['actorId'])
          || request.resource.data.actorId is string
        )
        && (
          !request.resource.data.keys().hasAny(['avatarUrl'])
          || request.resource.data.avatarUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role is string
        );
    }

    function isAllowedChannelMessageWrite(threadId) {
      return hasOnlyKeys(request.resource.data, [
          'bundleId',
          'channelId',
          'createdAtMs',
          'isUser',
          'message',
          'mode',
          'ownerUid',
          'title'
        ])
        && hasRequiredKeys(request.resource.data, [
          'bundleId',
          'channelId',
          'createdAtMs',
          'isUser',
          'message',
          'mode',
          'ownerUid',
          'title'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.bundleId == threadId
        && request.resource.data.channelId is string
        && request.resource.data.createdAtMs is number
        && request.resource.data.isUser is bool
        && request.resource.data.message is map
        && request.resource.data.mode in ['production', 'dev']
        && request.resource.data.title is string;
    }

    function isOwnedChannelThreadDocId(threadId) {
      return isSignedIn()
        && (
          threadId.matches('^production__' + request.auth.uid + '__[^/]+$')
          || threadId.matches('^dev__' + request.auth.uid + '__[^/]+$')
        );
    }

    match /v2/app/users/{uid} {
      allow read: if isOwner(uid) || isModerator();
      allow create: if isOwner(uid)
        && isAllowedUserProfileWrite(uid)
        && !request.resource.data.keys().hasAny([
          'pointsCurrent',
          'streakCount',
          'streakLastUpdatedAt',
          'streakMultiplierCurrent',
          'awardedGroupBonusIds'
        ]);
      allow update: if isOwner(uid)
        && isAllowedUserProfileWrite(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            !resource.data.keys().hasAny(['pointsCurrent'])
            && !request.resource.data.keys().hasAny(['pointsCurrent'])
          )
          || (
            resource.data.keys().hasAny(['pointsCurrent'])
            && request.resource.data.keys().hasAny(['pointsCurrent'])
            && request.resource.data.pointsCurrent == resource.data.pointsCurrent
          )
        )
        && (
          (
            !resource.data.keys().hasAny(['streakCount'])
            && !request.resource.data.keys().hasAny(['streakCount'])
          )
          || (
            resource.data.keys().hasAny(['streakCount'])
            && request.resource.data.keys().hasAny(['streakCount'])
            && request.resource.data.streakCount == resource.data.streakCount
          )
        )
        && (
          (
            !resource.data.keys().hasAny(['streakLastUpdatedAt'])
            && !request.resource.data.keys().hasAny(['streakLastUpdatedAt'])
          )
          || (
            resource.data.keys().hasAny(['streakLastUpdatedAt'])
            && request.resource.data.keys().hasAny(['streakLastUpdatedAt'])
            && request.resource.data.streakLastUpdatedAt == resource.data.streakLastUpdatedAt
          )
        )
        && (
          (
            !resource.data.keys().hasAny(['streakMultiplierCurrent'])
            && !request.resource.data.keys().hasAny(['streakMultiplierCurrent'])
          )
          || (
            resource.data.keys().hasAny(['streakMultiplierCurrent'])
            && request.resource.data.keys().hasAny(['streakMultiplierCurrent'])
            && request.resource.data.streakMultiplierCurrent == resource.data.streakMultiplierCurrent
          )
        )
        && (
          (
            !resource.data.keys().hasAny(['awardedGroupBonusIds'])
            && !request.resource.data.keys().hasAny(['awardedGroupBonusIds'])
          )
          || (
            resource.data.keys().hasAny(['awardedGroupBonusIds'])
            && request.resource.data.keys().hasAny(['awardedGroupBonusIds'])
            && request.resource.data.awardedGroupBonusIds == resource.data.awardedGroupBonusIds
          )
        );
      allow delete: if false;
    }

    match /v2/app/tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isModerator();
    }

    match /v2/app/channelThreads/{threadId} {
      allow get: if isModerator()
        || isOwnedChannelThreadDocId(threadId)
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isModerator() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update: if isSignedIn() && isAllowedChannelThreadWrite();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isModerator() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
        allow create, update: if isSignedIn() && isAllowedChannelMessageWrite(messageId);
        allow delete: if false;
      }
    }

    match /v2/app/submissions/{submissionId} {
      allow read: if isModerator() || isSubmissionOwner(resource.data);
      allow create, update, delete: if isModerator();
    }

    match /v2/app/scoreEvents/{eventId} {
      allow read: if isModerator() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isModerator() && isAllowedScoreEvent(eventId);
      allow update, delete: if false;
    }

    match /v2/app/leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /v2/app/narrativeState/{bundleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /v2/app/narrativeStateDev/{bundleId} {
      allow read: if hasDevClaim();
      allow write: if false;
    }

    match /v2/app/narrativeReactions/{docId} {
      allow read: if canReadNarrativeReactionDoc(docId);
      allow write: if false;
    }

    match /v2/app/narrativeUserReactions/{docId} {
      allow read: if isModerator() || isNarrativeUserReactionOwnerDoc(docId);
      allow write: if false;
    }

    match /v2/app/liveSessions/{sessionId} {
      allow read: if canReadLiveSession(sessionId);
      allow write: if false;

      match /participants/{uid} {
        allow read: if isModerator() || isOwner(uid);
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isModerator() || (canReadLiveSession(sessionId) && isLiveSessionParticipant(sessionId));
        allow write: if false;
      }

      match /private/{docId} {
        allow read, write: if false;
      }
    }

    match /v2/app/liveShowWindows/{windowId} {
      allow read: if isModerator()
        || (
          isSignedIn()
          && resource.data.mode == 'production'
        )
        || (
          hasDevClaim()
          && resource.data.mode == 'dev'
        );
      allow write: if false;
    }

    match /v2/app/fcmRegistrations/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Legacy app namespace (currently deployed in production).
    // Keep this until legacy reads/writes are fully retired.
    match /users/{userId}/{documents=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Catch-all deny for any path not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
