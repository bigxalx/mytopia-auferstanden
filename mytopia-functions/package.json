{
  "name": "mytopia-functions",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cleanup-launch-artifacts": "bun --env-file=.env ./scripts/cleanup-launch-artifacts.mjs",
    "deploy": "bun ./scripts/deploy.mjs",
    "repair-channel-threads": "bun ./scripts/repair-channel-threads.mjs",
    "set-claim": "bun ./scripts/set-claim.mjs",
    "test:rules": "firebase emulators:exec --only firestore --config firebase.json --project demo-mytopia-live-rules \"bun test test/live-firestore.rules.test.ts\"",
    "webhook:probe": "bun --env-file=.env ./scripts/probe-webhook-signature.mjs"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.4.1",
    "@sanity/webhook": "^4.0.4",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.2.0",
    "google-auth-library": "^9.14.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^25.3.3",
    "firebase": "^12.15.0",
    "typescript": "^5.9.2"
  }
}
